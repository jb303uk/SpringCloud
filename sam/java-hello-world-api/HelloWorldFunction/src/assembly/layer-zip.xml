<assembly xmlns="http://apache.org"
          xmlns:xsi="http://w3.org"
          xsi:schemaLocation="http://apache.org http://apache.org">
    <id>layer-zip</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <fileSets>
        <fileSet>
            <!-- Selects the java directory built by dependency plugin -->
            <directory>${project.build.directory}/java</directory>
            <outputDirectory>java</outputDirectory>
        </fileSet>
    </fileSets>
</assembly>
